geode":"5.11.2",
  "gd": { "android32": "2.2074", "android64": "2.2074" },
  "id": "tuusuario.afterflow",
  "name": "Afterflow",
  "version": "v0.3.0",
  "developer": "tuusuario",
  "description": "Corrige clicks y soltados prematuros probando el input en ticks futuros.",
  "settings": {
    "enabled": { "type": "bool", "name": "Activar Afterflow", "default": true },
    "window-ticks": {
      "type": "int",
      "name": "Ventana de perdón (ticks @240/s)",
      "description": "Cuántos ticks puede retrasar un input. 6 ticks = 25 ms.",
      "default": 6, "min": 1, "max": 24,
      "control": { "slider": true }
    },
    "lookahead-ticks": {
      "type": "int",
      "name": "Ticks a simular por prueba",
      "default": 25, "min": 10, "max": 120,
      "control": { "slider": true }
    },
    "time-cap-ms": {
      "type": "int",
      "name": "Tope de tiempo por click (ms)",
      "description": "Si la simulación tarda más, se cancela y el input pasa normal (evita congelamientos).",
      "default": 4, "min": 1, "max": 20,
      "control": { "slider": true }
    },
    "fix-click": { "type": "bool", "name": "Corregir clicks tempranos", "default": true },
    "fix-release": { "type": "bool", "name": "Corregir soltados tempranos", "default": true },
    "practice-only": { "type": "bool", "name": "Solo en modo práctica", "default": true },
    "record": {
      "type": "bool",
      "name": "Grabar clics en práctica",
      "description": "Guarda dónde das clic al avanzar en práctica. Afterflow solo ayuda cerca de esos puntos.",
      "default": true
    },
    "only-recorded": { "type": "bool", "name": "Ayudar solo en clics grabados", "default": true },
    "tolerance-units": {
      "type": "int",
      "name": "Radio alrededor del clic grabado (unidades)",
      "description": "30 unidades = 1 bloque.",
      "default": 45, "min": 10, "max": 150,
      "control": { "slider": true }
    }
  }
}
